// static/js/task-status.js
import { updateTasksSection } from './calendar-update.js';
import { bindAllTaskHandlers } from './tasks.js';

export function updateTaskStatusSections(tasks, date, day, categories, year, month) {
    console.log(`[updateTaskStatusSections] Обновление задач для ${date}`);
    const activeTasks = tasks.filter(task => !task.completed);
    const completedTasks = tasks.filter(task => task.completed);

    updateTasksSection(activeTasks, date, day, categories, 'active-tasks-section', 'Активные задачи');
    updateTasksSection(completedTasks, date, day, categories, 'completed-tasks-section', 'Выполненные задачи');

    bindAllTaskHandlers(parseInt(year), parseInt(month));
}

export function moveTaskToCompleted(taskId, year, month, day) {
    console.log(`[moveTaskToCompleted] Перемещение задачи ${taskId} в выполненные`);
    fetch(`/tasks/${year}/${month}/${day}/complete`, {
        method: 'POST',
        body: JSON.stringify({ task_id: taskId }),
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => {
        if (!response.ok) throw new Error('Сетевая ошибка');
        return response.json();
    })
    .then(data => {
        if (data.success) {
            console.log(`[moveTaskToCompleted] Задача ${taskId} помечена как выполненная`);
            fetchTasks(year, month, day);
        }
    })
    .catch(error => {
        console.error('[moveTaskToCompleted] Ошибка:', error);
    });
}

function fetchTasks(year, month, day) {
    console.log(`[fetchTasks] Запрос задач для ${year}-${month}-${day}`);
    fetch(`/tasks/${year}/${month}/${day}`, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(response => {
        if (!response.ok) throw new Error('Сетевая ошибка');
        return response.json();
    })
    .then(data => {
        updateTaskStatusSections(data.tasks, data.date, day, data.categories, year, month);
    })
    .catch(error => {
        console.error('[fetchTasks] Ошибка:', error);
    });
}